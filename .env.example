# Remote Commands (Phase 6 MVP)

# Server
PORT=3020
HOST=0.0.0.0
LOG_LEVEL=info

# Auth (matches patterns used in fleet-management)
AUTH_REQUIRED=false
JWT_ISSUER=
JWT_AUDIENCE=
JWT_CLOCK_TOLERANCE_SECONDS=0

# Store backend
# RC_STORE=memory|file
RC_STORE=file
RC_STORE_FILE_PATH=./data/remote-commands.json
RC_MAX_RECENT_PER_VEHICLE=50

# Dispatch integration
# Prefer Kafka if enabled; otherwise HTTP fallback is used.
RC_USE_KAFKA=false

# Kafka settings
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=remote-commands
KAFKA_CONSUMER_GROUP_ID=remote-commands-acks-v1

# Topics
KAFKA_TOPIC_REMOTE_COMMAND=remote-command.v1
KAFKA_TOPIC_COMMAND_ACK=command-ack.v1

# HTTP fallback settings (dev/local)
RC_GATEWAY_HTTP_URL=http://localhost:3004
# Where gateway should send ack callbacks (used by gateway if you enable it)
RC_PUBLIC_HTTP_URL=http://localhost:3020

# Command lifecycle
RC_ACK_TIMEOUT_MS=15000
